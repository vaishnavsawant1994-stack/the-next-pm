# Dedicated database only. Do not commit actual credentials.
DATABASE_URL=postgresql://user:password@localhost:5432/the_next_pm

# Trusted operator shell ONLY; keep false in the public web runtime.
EDITORIAL_OPERATOR_ENABLED=false
EDITORIAL_STAFF_BOOTSTRAP=false

# Staff access (do not expose as NEXT_PUBLIC_* variables).
# Create with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
