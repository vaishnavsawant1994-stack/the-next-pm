{
  "name": "the-next-pm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:status": "node scripts/db.mjs status",
    "auth:migrate": "npx auth@1.6.30 migrate --yes"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pg": "^8.16.3",
    "better-auth": "1.6.30"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "typescript": "^5.9.0",
    "@types/pg": "^8.15.5"
  }
}
